generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  clerkUserId    String         @unique
  email          String         @unique
  name           String?
  imageUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  partnerOneName String?
  partnerTwoName String?

  // --- Ending a space ---------------------------------------------------
  // A space runs ACTIVE until someone ends it, spends the cooldown in
  // COOLING_DOWN, then forks into two ARCHIVED spaces — one per partner.
  spaceStatus        SpaceStatus @default(ACTIVE)
  // Who pressed the button. Only they can call it off, so the partner who
  // wants out can't be held in the space by the other one cancelling forever.
  closureInitiatedBy String?
  closureStartedAt   DateTime?
  // When the fork becomes due. Nothing fires on its own — the next request
  // into the space notices the date has passed and forks then.
  closesAt           DateTime?
  archivedAt         DateTime?
  // Set on the copy that was split off, pointing at the space it came from.
  // Provenance only: the two archives are fully independent rows.
  forkedFromId       String?
  collections    Collection[]
  comments       Comment[]
  currentDraft   Draft?
  entries        Entry[]
  memories       Memory[]
  messages       Message[]
  notifications  Notification[]
  spaceInvites   SpaceInvite[]
  identities     UserIdentity[]
  spaceAccess    SpaceAccess[]
  conversations  ChatConversation[]
  courtroomCases CourtroomCase[]
  reminders      Reminder[]
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  title     String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatConversation {
  id        String     @id @default(cuid())
  userId    String
  // Which partner this conversation belongs to. Solo Vent is the one place in
  // a shared space that is *not* shared — without this, both partners read the
  // same list, so venting about someone lands in front of them.
  //
  // An author slot rather than a clerkUserId: deleting a login and signing back
  // in mints a fresh Clerk id (it has happened here), which would orphan
  // someone's history. Slots survive that, and match how authorship works
  // everywhere else in the app.
  //
  // Nullable only for rows written before this column existed; those are
  // unattributable, so nothing matches them and they stay hidden.
  ownerSlot String?
  title     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells     ChatCell[]

  @@index([userId])
  @@index([userId, ownerSlot])
}

model ChatCell {
  id             String           @id @default(cuid())
  conversationId String
  content        String           @db.Text
  response       String?          @db.Text
  order          Int
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CourtroomCase {
  id               String     @id @default(cuid())
  userId           String
  title            String
  status           CaseStatus @default(OPEN)
  sideAPerspective String?    @db.Text
  sideBPerspective String?    @db.Text
  sideAAuthor      String?
  sideBAuthor      String?
  judgement        String?    @db.Text
  // The Heart Contract: terms both sides agree to after the verdict
  contract         String?    @db.Text
  sideASignedAt    DateTime?
  sideBSignedAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CaseStatus {
  OPEN
  PENDING
  CLOSED
}

model UserIdentity {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Every space this login is allowed to open — as opposed to UserIdentity, which
 * is the single space it is currently *in*.
 *
 * Without this the two are the same thing, and a breakup is a dead end: the
 * fork points your identity at an archive, an archive is full of entries, and
 * joining a partner refuses any account whose current space has entries in it.
 * The account is then stuck in that archive permanently, with no way to pair
 * with anyone ever again short of abandoning the Google account entirely.
 *
 * Splitting "can open" from "currently in" makes moving on possible without
 * giving anything up: switching spaces just repoints the identity, and the
 * archive stays listed here to return to or download for as long as it exists.
 */
model SpaceAccess {
  id          String   @id @default(cuid())
  clerkUserId String
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clerkUserId, userId])
  @@index([clerkUserId])
  @@index([userId])
}

model SpaceInvite {
  id                String       @id @default(cuid())
  token             String       @unique
  userId            String
  status            InviteStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedByClerkId String?
  createdByClerkId  String
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     Entry[]

  @@unique([name, userId])
}

model Entry {
  id           String      @id @default(cuid())
  title        String
  content      String
  mood         String
  moodScore    Int
  moodImageUrl String?
  author       String      @default("Both Partners")
  collectionId String?
  userId       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  comments     Comment[]
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Draft {
  id        String   @id @default(cuid())
  title     String?
  content   String?
  mood      String?
  author    String?  @default("Both Partners")
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id            String         @id @default(cuid())
  content       String
  author        String
  entryId       String
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entry         Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

model Notification {
  id            String   @id @default(cuid())
  type          String
  message       String
  entryId       String?
  entryTitle    String?
  caseId        String?
  commentId     String?
  commentAuthor String?
  // Couple space this notification belongs to; nullable only for legacy rows
  userId        String?
  hunterRead    Boolean  @default(false)
  riceeeRead    Boolean  @default(false)
  createdAt     DateTime @default(now())
  comment       Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  sender         String
  userId         String
  read           Boolean  @default(false)
  replyTo        String?
  replyToContent String?
  replyToSender  String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(cuid())
  url        String
  key        String
  caption    String?
  uploadedBy String
  userId     String
  fileSize   Int
  mimeType   String
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SpaceStatus {
  ACTIVE
  COOLING_DOWN
  ARCHIVED
}
