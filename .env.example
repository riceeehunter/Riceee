# Copy into .env (database + Gemini — the Prisma CLI reads that file directly)
# and .env.local (everything else), then fill in your own values.
# Never commit the filled-in files.

# ── Database ─────────────────────────────────────────────────────────────
# Postgres. Any provider works; this project runs on Neon.
# pgbouncer=true enables connection pooling, which serverless needs.
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true&connection_limit=10"

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI (Google Gemini) ───────────────────────────────────────────────────
# Belongs in .env alongside DATABASE_URL.
GEMINI_API_KEY=
# Optional. Chat uses a fast model; verdicts use a stronger one with thinking
# enabled, since a ruling happens rarely and deserves real deliberation.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_JUDGE_MODEL=gemini-flash-latest

# ── Real-time (Pusher) ───────────────────────────────────────────────────
# Drives the multiplayer games and live message delivery.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Photo storage (Cloudflare R2) ────────────────────────────────────────
# S3-compatible. R2_PUBLIC_URL is the bucket's public base URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Rate limiting / bot protection (Arcjet) ──────────────────────────────
ARCJET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Stock imagery for mood cards. The app runs fine without it.
PIXABAY_API_KEY=
